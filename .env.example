# Copy this file to /server/.env (or project root .env) and fill in your values.
# XAMPP default: user root, empty password, host 127.0.0.1

DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=
DB_NAME=sha_db
DB_PORT=3306

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

HOST=0.0.0.0
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
COOKIE_SAMESITE=lax
NODE_ENV=development

# Production example:
# NODE_ENV=production
# CLIENT_ORIGIN=https://your-domain.com
# COOKIE_SAMESITE=lax
